PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=libra
DB_USER=libra
DB_PASSWORD=libra
DB_SYNCHRONIZE=true
PAYMENT_URL=http://127.0.0.1:8081
PAYMENT_API_KEY=local-secret
CARD_VALIDATION_URL=http://127.0.0.1:8082
CARD_VALIDATION_API_KEY=local-card-secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=libra
POSTGRES_PASSWORD=libra
POSTGRES_DB=libra
# In production, prefer a full connection string instead of separate values.
# DATABASE_URL=postgresql://libra:libra@localhost:5432/libra

# Pedidos entregues sintéticos para relatórios (0 a 100000), além dos 4 pedidos básicos.
SALES_SEED_COUNT=20000

# Trocas adicionais, limitadas à quantidade de pedidos sintéticos.
EXCHANGES_SEED_COUNT=1000

# Assistente: exclusivamente Gemini. Configure a chave para habilitar respostas.
GEMINI_API_KEY=KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
